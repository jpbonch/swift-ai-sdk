{
  "name": "swift-ai-sdk-site",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "pnpm": ">=11"
  },
  "scripts": {
    "api:extract": "bun scripts/extract-api.ts",
    "api:reference": "pnpm api:extract && bun scripts/build-reference.ts && bun scripts/build-troubleshooting.ts",
    "build": "pnpm api:reference && next build",
    "dev": "pnpm api:reference && next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit && tsc --noEmit -p scripts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.58",
    "@ai-sdk/xai": "^4.0.30",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@paper-design/shaders-react": "^0.0.78",
    "@remixicon/react": "^4.9.0",
    "@types/hast": "^3.0.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.55",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.1.0",
    "flexsearch": "^0.8.212",
    "fumadocs-core": "^16.14.1",
    "fumadocs-mdx": "^15.2.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.14.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
